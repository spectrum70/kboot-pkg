[Defines]
# Standard x64 OVMF memory addresses for 2026
DEFINE FW_BASE_ADDRESS = 0xFFC00000
DEFINE FW_SIZE         = 0x00400000
DEFINE BLOCK_SIZE      = 0x1000

################################################################################
# FD (Flash Device) Section: Defines the final .fd binary layout
################################################################################
[FD.KBOOT]
BaseAddress   = $(FW_BASE_ADDRESS)
Size          = $(FW_SIZE)
ErasePolarity = 1
BlockSize     = $(BLOCK_SIZE)
NumBlocks     = 0x400

# Map the Firmware Volume to the start of the Flash Device
0x00000000|$(FW_SIZE)
FV = KBOOT

################################################################################
# FV (Firmware Volume) Section: The storage volume for files
################################################################################
[FV.KBOOT]
BlockSize          = $(BLOCK_SIZE)
FvAlignment        = 16
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = TRUE
WRITE_STATUS       = TRUE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

#------------------------------------------------------------------------------
# 1. EMBEDDED BMP (RAW DATA)
# Wrapped in a FREEFORM file with the requested GUID.
#------------------------------------------------------------------------------
#FILE FREEFORM = 4E3D896A-6D8E-4A6F-8D0B-5F1C6E3D81DC {
#  SECTION RAW = MyProjectPkg/Resources/MyLogo.bmp
#}

#------------------------------------------------------------------------------
# 2. THE UEFI APPLICATION
# Include your application's .inf here.
#------------------------------------------------------------------------------
INF  kboot-pkg/kboot/kboot.inf

# Standard core modules required for the firmware volume to be valid
INF  MdeModulePkg/Core/Dxe/DxeMain.inf

################################################################################
# Rules Section: Defines how to package the INF modules into the FV
################################################################################
[Rule.Common.DXE_CORE]
  FILE DXE_CORE = $(NAMED_GUID) {
    PE32      PE32 $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING = "$(MODULE_NAME)"
  }

[Rule.Common.UEFI_APPLICATION]
  FILE APPLICATION = $(NAMED_GUID) {
    PE32      PE32 $(INF_OUTPUT)/$(MODULE_NAME).efi
    UI        STRING = "$(MODULE_NAME)"
  }
