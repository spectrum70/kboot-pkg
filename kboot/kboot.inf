[Defines]
  INF_VERSION                    = 1.90
  BASE_NAME                      = kboot
  FILE_GUID                      = 7c65f3cf-b379-415d-9161-1dc597a41fb0
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = uefi_main
#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = IA32 X64 IPF EBC Etc...
#

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = -I$(WORKSPACE)/kboot-pkg/kboot/include

[Sources]
  src/main.c
  src/log.c
  src/menu.c
  src/fs.c
  src/loader.c
  src/cpu.c
  src/memory.c
  src/utils.c
  src/fb.c
  src/firmware.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  EmulatorPkg/EmulatorPkg.dec

[LibraryClasses]
  BmpSupportLib
  DxeServiceLib
  FileHandleLib
  PciLib
  SmbiosLib
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib

[Guids]
  gEfiAcpiTableGuid
  gEfiAcpi10TableGuid
  gEfiAcpi20TableGuid

[Ppis]

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
  gEfiBlockIoProtocolGuid
  gEfiPartitionInfoProtocolGuid
  gEfiGraphicsOutputProtocolGuid
  gEfiLoadFile2ProtocolGuid
  gEfiSmbiosProtocolGuid
  gEfiFormBrowser2ProtocolGuid

[Binaries.common]
